# Mot de passe unique pour accéder à l'application (obligatoire en production)
APP_PASSWORD=change-moi
# Secret de signature du cookie de session (32+ caractères aléatoires : openssl rand -hex 32)
SESSION_SECRET=remplace-par-une-longue-chaine-aleatoire
# Dossier de la base SQLite (monté en volume dans Docker)
DATA_DIR=./data
# Optionnel : chemin de LibreOffice si « soffice » n'est pas dans le PATH (ex. Windows)
# SOFFICE_PATH=C:/Program Files/LibreOffice/program/soffice.exe
# Optionnel : "false" pour autoriser le cookie en HTTP simple (test local sans HTTPS)
# COOKIE_SECURE=false
# Optionnel : assistant de rédaction IA (Perplexity). Sans clé, le bouton « Assistant » indique qu'il est désactivé.
# PERPLEXITY_API_KEY=pplx-...
# Optionnel : modèle de l'Agent API Perplexity (défaut : perplexity/sonar)
# PERPLEXITY_MODEL=perplexity/sonar
